{
  // Cloudflare deploy settings for Baby Abroad: a static site served from ./dist,
  // plus a small Worker (worker/index.js) that handles /api/* for Stripe checkout.
  "name": "baby-abroad",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  // Keep any variables or secrets you set in the Cloudflare dashboard when this deploys from GitHub.
  "keep_vars": true,
  // The quiz webhook address on n8n. It is not secret (n8n checks the secret token), so it lives here
  // and survives every deploy. The token itself (N8N_AVAILABILITY_TOKEN) stays a dashboard secret.
  "vars": {
    "N8N_QUIZ_URL": "https://n8n.gobabyabroad.com/webhook/baby-abroad-quiz"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Only /api/* runs the Worker first. Every other address is served straight from the site files.
    "run_worker_first": ["/api/*"],
    // Serve /faq (not /faq/) so the address matches each page's canonical URL.
    "html_handling": "drop-trailing-slash",
    // Unknown URLs get the real 404 page (with a true 404 status), not the home page.
    "not_found_handling": "404-page"
  }
}
